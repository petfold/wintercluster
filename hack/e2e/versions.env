# Pinned toolchain and images for the e2e harness.
#
# Everything the drill depends on is pinned here, in one place. An unpinned
# version turns a reproducible failure into a mystery, and this harness exists
# to produce evidence — see CLAUDE.md, "pin versions in the harness".
KIND_VERSION=v0.33.0
KUBECTL_VERSION=v1.37.0
HELM_VERSION=v4.2.4
VELERO_VERSION=v1.18.2
VELERO_PLUGIN_AWS_VERSION=v1.14.2

# s3warm v0.5.0 is the first release whose commit chain can carry SSE objects
# (sealed references). Earlier releases either refuse to commit an encrypted
# bucket or leak its keys, so the drill is meaningless against them.
S3WARM_MIN_VERSION=v0.5.0

# Where the s3warm checkout lives; its compose stack and fakebee are reused
# rather than reimplemented.
S3WARM_REPO=${S3WARM_REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/../s3warm}

CLUSTER_NAME=${CLUSTER_NAME:-wintercluster-e2e}
BSL_BUCKET=${BSL_BUCKET:-velero}
S3_ACCESS_KEY=${S3_ACCESS_KEY:-s3warmdev}
S3_SECRET_KEY=${S3_SECRET_KEY:-s3warmdevsecret}
